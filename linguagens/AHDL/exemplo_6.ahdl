-- Cópia legada para estudo; .ahdl não é extensão oficial documentada para AHDL.
-- O arquivo canônico do fluxo Quartus é o correspondente .tdf.
SUBDESIGN exemplo_6
(
  data[7..0] : INPUT;
  q[7..0] : OUTPUT;
)
VARIABLE
  q_node[7..0] : NODE;
q_node[] = data[];
q[] = q_node[];
-- Primitivas como DFF dependem da biblioteca e da versão do Quartus.
