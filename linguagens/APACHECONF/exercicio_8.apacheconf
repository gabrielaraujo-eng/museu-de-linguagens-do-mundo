# =====================================================================
# Museu de Linguagens do Mundo - pasta APACHECONF
# exercicio_8.conf - endurecimento por cabecalhos
#
# Tarefa: aplicar CSP, negar enquadramento em outros dominios,
# desativar MIME sniffing e remover cabecalhos de versao.
#
# Teste de sintaxe:  apache2 -t -f <este arquivo>
# Requer Apache HTTP Server 2.4 com os modulos compartilhados
# instalados em /usr/lib/apache2/modules (padrao Debian/Ubuntu).
# =====================================================================

# --- Preambulo: permite validar este arquivo isoladamente -------
ServerRoot "/etc/apache2"
Listen 8098
LoadModule mpm_event_module "/usr/lib/apache2/modules/mod_mpm_event.so"
LoadModule authz_core_module "/usr/lib/apache2/modules/mod_authz_core.so"
LoadModule authz_host_module "/usr/lib/apache2/modules/mod_authz_host.so"
LoadModule dir_module "/usr/lib/apache2/modules/mod_dir.so"
LoadModule mime_module "/usr/lib/apache2/modules/mod_mime.so"
LoadModule headers_module "/usr/lib/apache2/modules/mod_headers.so"
ServerName linguagens.museu.test
ErrorLog "/var/log/apache2/apacheconf-error.log"
# --- Fim do preambulo -------------------------------------------
DocumentRoot "/var/www/museu"

<Directory "/var/www/museu">
    Options -Indexes +FollowSymLinks
    AllowOverride None
    Require all granted
</Directory>

# Aplicado inclusive em respostas de erro ("always").
Header always set Content-Security-Policy "default-src 'self'; object-src 'none'; frame-ancestors 'none'"
Header always set X-Frame-Options "DENY"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "no-referrer"
Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

# Nao anuncia a versao do servidor nas respostas de erro.
Header always unset X-Powered-By
Header always unset X-Generator

# Recursos versionados podem ser cacheados por muito tempo.
<FilesMatch "\.(css|js|woff2|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# Documentos HTML nunca sao cacheados sem revalidacao.
<FilesMatch "\.html?$">
    Header set Cache-Control "no-cache"
</FilesMatch>

ErrorLog "/var/log/apache2/museu-error.log"
