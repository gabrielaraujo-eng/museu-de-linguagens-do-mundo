# =====================================================================
# Museu de Linguagens do Mundo - pasta APACHECONF
# exemplo_10.conf - HTTPS com mod_ssl
#
# Dois virtual hosts: a porta 8080 redireciona para 8080/seguro e a
# porta 8443 termina TLS com SSLEngine, certificado, chave e HSTS.
#
# Teste de sintaxe:  apache2 -t -f <este arquivo>
# Requer Apache HTTP Server 2.4 com os modulos compartilhados
# instalados em /usr/lib/apache2/modules (padrao Debian/Ubuntu).
# =====================================================================

# --- Preambulo: permite validar este arquivo isoladamente -------
ServerRoot "/etc/apache2"
Listen 8080
LoadModule mpm_event_module "/usr/lib/apache2/modules/mod_mpm_event.so"
LoadModule authz_core_module "/usr/lib/apache2/modules/mod_authz_core.so"
LoadModule authz_host_module "/usr/lib/apache2/modules/mod_authz_host.so"
LoadModule dir_module "/usr/lib/apache2/modules/mod_dir.so"
LoadModule mime_module "/usr/lib/apache2/modules/mod_mime.so"
LoadModule ssl_module "/usr/lib/apache2/modules/mod_ssl.so"
LoadModule headers_module "/usr/lib/apache2/modules/mod_headers.so"
LoadModule rewrite_module "/usr/lib/apache2/modules/mod_rewrite.so"
ServerName museu.test
ErrorLog "/var/log/apache2/apacheconf-error.log"
# --- Fim do preambulo -------------------------------------------
# ---- Porta em texto claro: apenas redireciona --------------------------
<VirtualHost *:8080>
    ServerName museu.test
    ServerAlias www.museu.test

    RewriteEngine On
    RewriteRule "^(.*)$" "https://museu.test:8443$1" [R=301,L]
</VirtualHost>

# ---- Porta TLS ---------------------------------------------------------
Listen 8443

<VirtualHost *:8443>
    ServerName museu.test
    DocumentRoot "/var/www/museu"

    SSLEngine on
    SSLCertificateFile "/etc/ssl/museu/museu.crt"
    SSLCertificateKeyFile "/etc/ssl/museu/museu.key"
    # Somente TLS 1.2 e 1.3.
    SSLProtocol -all +TLSv1.2 +TLSv1.3

    <Directory "/var/www/museu">
        Options -Indexes +FollowSymLinks
        AllowOverride None
        Require all granted
    </Directory>

    # HSTS: o navegador passa a exigir HTTPS por um ano.
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Content-Type-Options "nosniff"

    ErrorLog "/var/log/apache2/museu-ssl-error.log"
    LogFormat "%v %h %t \"%r\" %>s %b" ssl_log
    CustomLog "/var/log/apache2/museu-ssl-access.log" ssl_log
</VirtualHost>
