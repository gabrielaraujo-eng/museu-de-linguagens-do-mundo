# =====================================================================
# Museu de Linguagens do Mundo - pasta APACHECONF
# exemplo_2.conf - virtual hosts por nome
#
# Dois <VirtualHost> no mesmo endereco e porta, distinguidos por
# ServerName e ServerAlias (hospedagem virtual baseada em nome).
#
# Teste de sintaxe:  apache2 -t -f <este arquivo>
# Requer Apache HTTP Server 2.4 com os modulos compartilhados
# instalados em /usr/lib/apache2/modules (padrao Debian/Ubuntu).
# =====================================================================

# --- Preambulo: permite validar este arquivo isoladamente -------
ServerRoot "/etc/apache2"
Listen 8082
LoadModule mpm_event_module "/usr/lib/apache2/modules/mod_mpm_event.so"
LoadModule authz_core_module "/usr/lib/apache2/modules/mod_authz_core.so"
LoadModule authz_host_module "/usr/lib/apache2/modules/mod_authz_host.so"
LoadModule dir_module "/usr/lib/apache2/modules/mod_dir.so"
LoadModule mime_module "/usr/lib/apache2/modules/mod_mime.so"
ServerName linguagens.museu.test
ErrorLog "/var/log/apache2/apacheconf-error.log"
# --- Fim do preambulo -------------------------------------------
# O primeiro VirtualHost de um par IP:porta e o host padrao.
<VirtualHost *:8082>
    ServerName linguagens.museu.test
    ServerAlias www.linguagens.museu.test
    DocumentRoot "/var/www/linguagens"
    <Directory "/var/www/linguagens">
        Options -Indexes +FollowSymLinks
        AllowOverride None
        Require all granted
    </Directory>
    ErrorLog "/var/log/apache2/linguagens-error.log"
    LogFormat "%v %h %t \"%r\" %>s %b" porhost
    CustomLog "/var/log/apache2/linguagens-access.log" porhost
</VirtualHost>

<VirtualHost *:8082>
    ServerName arquivo.museu.test
    DocumentRoot "/var/www/arquivo"
    <Directory "/var/www/arquivo">
        Options -Indexes +FollowSymLinks
        AllowOverride None
        Require all granted
    </Directory>
    ErrorLog "/var/log/apache2/arquivo-error.log"
    CustomLog "/var/log/apache2/arquivo-access.log" porhost
</VirtualHost>
