begin
  comment exercicio 9: calcule a hipotenusa e a area de um triangulo retangulo;
  real cateto1, cateto2, hipotenusa, area;
  cateto1 := 3.0;
  cateto2 := 4.0;
  hipotenusa := sqrt (cateto1 * cateto1 + cateto2 * cateto2);
  area := cateto1 * cateto2 / 2.0;
  outstring (1, "hipotenusa: ");
  outreal (1, hipotenusa);
  newline (1);
  outstring (1, "area: ");
  outreal (1, area);
  newline (1)
end
