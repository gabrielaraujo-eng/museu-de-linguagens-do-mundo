begin
  comment exemplo 3: selecao com if, then e else;
  integer nota;
  nota := 7;
  outstring (1, "nota ");
  outinteger (1, nota);
  outstring (1, ": ");
  if nota >= 7 then outstring (1, "aprovado")
  else if nota >= 5 then outstring (1, "recuperacao")
  else outstring (1, "reprovado");
  newline (1)
end
