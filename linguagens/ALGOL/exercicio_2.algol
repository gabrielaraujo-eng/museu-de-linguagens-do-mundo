begin
  comment exercicio 2: converta uma temperatura de Celsius para Fahrenheit;
  comment formula: f := 9 / 5 * c + 32;
  real c, f;
  c := 10.0;
  f := 9.0 / 5.0 * c + 32.0;
  outstring (1, "celsius: ");
  outreal (1, c);
  newline (1);
  outstring (1, "fahrenheit: ");
  outreal (1, f);
  newline (1)
end
