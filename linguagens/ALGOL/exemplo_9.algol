begin
  comment exemplo 9: funcoes matematicas do ambiente padrao;
  real a, b;
  a := 16.0;
  b := 2.0;
  outstring (1, "sqrt(16) = ");
  outreal (1, sqrt (a));
  newline (1);
  outstring (1, "2 elevado a 10 = ");
  outreal (1, exp (10.0 * ln (b)));
  newline (1);
  outstring (1, "arctan(1) = ");
  outreal (1, arctan (1.0));
  newline (1);
  outstring (1, "entier(7.9) = ");
  outreal (1, entier (7.9));
  newline (1);
  outstring (1, "abs(-3.5) = ");
  outreal (1, abs (-3.5));
  newline (1)
end
