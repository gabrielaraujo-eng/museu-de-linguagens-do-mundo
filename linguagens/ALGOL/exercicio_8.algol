begin
  comment exercicio 8: receba uma string como parametro e imprima-a com marcadores;
  procedure marcado (rotulo, texto);
    string rotulo, texto;
  begin
    outstring (1, rotulo);
    outstring (1, ": ");
    outstring (1, texto);
    newline (1)
  end;
  marcado ("linguagem", "ALGOL 60");
  marcado ("ano do relatorio revisado", "1963");
  marcado ("uso", "descricao de algoritmos");
  newline (1)
end
